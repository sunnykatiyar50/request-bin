# Port the server listens on (default: 3007)
PORT=3007

# --- Authentication (required unless AUTH_DISABLED=true) ---
# Generate random values, e.g.:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Password for the web dashboard
ADMIN_PASSWORD=change-me

# Signs dashboard session cookies (32+ characters). Changing it signs everyone out.
SESSION_SECRET=change-me-to-a-random-string-of-at-least-32-chars

# Optional bearer token for the admin API from scripts and tests (16+ characters)
# ADMIN_TOKEN=

# Dashboard session lifetime in hours (default: 12)
# SESSION_TTL_HOURS=12

# Local development only: turns off authentication for the dashboard and admin API
# AUTH_DISABLED=true

# --- Capture ---
# Largest request body accepted, in KB (default: 1024)
# MAX_BODY_KB=1024

# Requests kept per bin; older ones are deleted (default: 500, 0 = unlimited)
# MAX_REQUESTS_PER_BIN=500

# Max captured requests per minute per client IP (default: 300)
# CAPTURE_RATE_LIMIT=300

# Delete captured requests older than this many days (default: 7, 0 = keep forever)
# RETENTION_DAYS=7

# Headers stored as "[redacted]" in bins with redaction on (comma-separated, lowercase)
# REDACT_HEADERS=authorization,proxy-authorization,cookie,x-api-key,x-bin-secret

# --- Operations ---
# SQLite database file (default: ./request-bin.sqlite)
# DATABASE_PATH=./request-bin.sqlite

# Set when running behind a reverse proxy (number of proxy hops, e.g. 1) so client IPs and HTTPS are detected
# TRUST_PROXY=1

# Directory for log files (default: ./logs)
# LOG_DIR=./logs
