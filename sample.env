# Port the server listens on (default: 30002)
PORT=30002

# --- Authentication (required unless AUTH_DISABLED=true) ---
# Generate random values, e.g.:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Capture URLs (/b/<bin id>/...) are always public, so webhook senders can reach them; a bin can
# require a secret instead. Everything else needs one of the credentials below.

# Dashboard sign-in (username defaults to "admin")
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Optional read-only dashboard accounts: they can view bins and captured requests, but can't create,
# change or delete anything, or see API keys. username:password pairs, comma-separated
# (passwords 8+ characters, no commas).
# VIEWER_USERS=alice:a-long-password,bob:another-long-password

# Signs dashboard session cookies (32+ characters). Changing it signs everyone out, and API keys and
# bin secrets can no longer be shown or copied (they keep working).
SESSION_SECRET=change-me-to-a-random-string-of-at-least-32-chars

# Read API keys (for tests that fetch captured requests) are created on the dashboard's API keys page.

# Optional: a token with full API access (creating bins, deleting requests), for scripts (16+ characters).
#   curl -H "Authorization: Bearer $ADMIN_TOKEN" http://localhost:30002/api/bins
# ADMIN_TOKEN=

# Dashboard session lifetime in hours (default: 12)
# SESSION_TTL_HOURS=12

# Local development only: turns off all authentication
# AUTH_DISABLED=true

# --- Capture ---
# Largest request body accepted, in KB (default: 1024, max: 16384). Larger bodies get 413.
# MAX_BODY_KB=1024

# Requests kept per bin; the oldest are deleted beyond this (default: 500)
# MAX_REQUESTS_PER_BIN=500

# Max captured requests per minute per client IP (default: 300)
# CAPTURE_RATE_LIMIT=300

# Headers whose values are stored as "[redacted]" in bins with redaction on (the default for new bins)
# REDACT_HEADERS=authorization,proxy-authorization,cookie,x-api-key,x-bin-secret

# --- Operations ---
# Set when running behind a reverse proxy (number of proxy hops, e.g. 1) so client IPs and HTTPS are detected
# TRUST_PROXY=1

# Delete captured requests older than this many days (default: 7, 0 = keep forever)
# RETENTION_DAYS=7

# Directory for log files (default: ./logs)
# LOG_DIR=./logs

# Set to false to log to stdout only (no log files)
# LOG_TO_FILE=true

# --- Database ---
# DB_TYPE picks the database: sqlite (default), postgres, or mysql.
DB_TYPE=sqlite

# SQLite: nothing else to set. The file defaults to ./request-bin.sqlite (in Docker: /app/data/request-bin.sqlite).
# Leave SQLITE_PATH unset when running in Docker.
# SQLITE_PATH=./request-bin.sqlite

# PostgreSQL: the same PG_* variables are used whether the database is the bundled container or
# any other server. Only PG_HOST (and possibly PG_SSL) changes:
#
#   Setup                                   PG_HOST                       Also
#   Bundled container (compose --profile)   postgres                      docker compose --profile postgres up -d
#   Server on the Docker host               host.docker.internal          -
#   Server elsewhere / hosted (Neon, RDS…)  its hostname or IP            usually PG_SSL=true
#   Running without Docker, local server    localhost                     -
#
# Never use localhost inside Docker: there it means the app's own container.
# DB_TYPE=postgres
# PG_HOST=postgres
# PG_PORT=5432
# PG_USER=requestbin
# PG_PASSWORD=change-me
# PG_DATABASE=requestbin
# TLS for the connection: false (default), true (verify the server certificate), or no-verify (self-signed)
# PG_SSL=false
# Extra CA certificate to trust, as a PEM file path (e.g. the AWS RDS bundle mounted into the container)
# PG_SSL_CA=

# MySQL: same idea with MYSQL_* (MYSQL_HOST follows the same rules as PG_HOST above;
# there is no bundled MySQL container).
# DB_TYPE=mysql
# MYSQL_HOST=host.docker.internal
# MYSQL_PORT=3306
# MYSQL_USER=requestbin
# MYSQL_PASSWORD=change-me
# MYSQL_DATABASE=requestbin
# MYSQL_SSL=false
# MYSQL_SSL_CA=
#
# The database itself (PG_DATABASE / MYSQL_DATABASE) must already exist on an external server;
# the tables are created automatically on startup.
